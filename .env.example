# Supabase (ticket #3+)
# Copy to .env.local and fill from your Supabase project settings.

# Project URL from Settings → API (must include https://)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=

# Integration tests only — never expose in the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=
